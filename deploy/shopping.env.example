# Copy to /etc/shopping-app/app.env on the Ubuntu host.
# Keep the real file out of Git and make it root:shopping-app mode 0640.
SHOPPING_ENV=production
SHOPPING_DATA_DIR=/var/lib/shopping-app
SHOPPING_HOST=127.0.0.1
SHOPPING_PORT=8000
SHOPPING_ALLOW_NON_LOOPBACK=false
PYTHONDONTWRITEBYTECODE=1
# Add optional keys only after deploying the compatible helper preparation.
# SHOPPING_OLLAMA_URL=http://127.0.0.1:11434
# SHOPPING_OLLAMA_MODEL=qwen3.5:9b
# SHOPPING_APP_ORIGIN=https://your-private-app.example.invalid
