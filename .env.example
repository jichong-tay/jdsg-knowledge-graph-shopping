# Local development defaults are shown below. Do not put secrets in this file.
SHOPPING_ENV=development
SHOPPING_DATA_DIR=./data
# Production requires an absolute SHOPPING_DATA_DIR. Optional path overrides:
# SHOPPING_DATABASE_PATH=/var/lib/shopping-app/shopping.sqlite3
# SHOPPING_RAW_EMAIL_DIR=/var/lib/shopping-app/raw-email
SHOPPING_HOST=127.0.0.1
SHOPPING_PORT=8000
# Keep false for the Tailscale Serve design. This override is intentionally explicit.
SHOPPING_ALLOW_NON_LOOPBACK=false
